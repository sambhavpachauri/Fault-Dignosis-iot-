# ==============================================================================
# P_311 Industrial IoT Fault Diagnosis System — Environment Configuration Template
# Copy this file to .env and configure credentials before deployment.
# ==============================================================================

# PostgreSQL Credentials
POSTGRES_DB=p311
POSTGRES_USER=p311_user
POSTGRES_PASSWORD=change_me_to_a_secure_password
POSTGRES_PORT=5432

# Database Connection Strings (SQLAlchemy)
# Use this when running FastAPI inside the Docker Compose network:
DATABASE_URL=postgresql+psycopg2://p311_user:change_me_to_a_secure_password@postgres:5432/p311

# Use this when running scripts or local backend outside Docker connecting to exposed port 5432:
LOCAL_DATABASE_URL=postgresql+psycopg2://p311_user:change_me_to_a_secure_password@127.0.0.1:5432/p311

# MQTT Telemetry Ingestion Broker
# 'host.docker.internal' routes from inside container to host Mosquitto
# '127.0.0.1' when running backend natively on host machine
MQTT_BROKER=host.docker.internal
MQTT_PORT=1883
MQTT_TOPIC=factory/machine1/sensors
